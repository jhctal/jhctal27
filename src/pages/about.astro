---
import NowList from '../components/NowList.astro';
import { PROFILE, PROJECTS } from '../consts';
import Base from '../layouts/Base.astro';

const project = (title: string) => PROJECTS.find((p) => p.title === title)?.href;
---

<Base title={`About — ${PROFILE.fullName}`}>
	<main class="container page">
		<header class="page-head">
			<span class="mono muted">About</span>
			<h1>Hi, I’m {PROFILE.name}. <span class="serif">{PROFILE.role}.</span></h1>
		</header>

		<div class="grid">
			<aside class="meta mono">
				<div>
					<span class="muted">Based in</span>
					<span>{PROFILE.location}</span>
				</div>
				<div>
					<span class="muted">Status</span>
					<span>{PROFILE.status}</span>
				</div>
				<div>
					<span class="muted">Contact</span>
					<a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
				</div>
			</aside>

			<div class="prose">
				<p>
					I’ve always been curious about how things work. As a kid I was constantly taking things
					apart to see what made them tick. That curiosity eventually led me to programming, where I
					found I enjoyed solving problems just as much as building things.
				</p>
				<p>
					Day to day I build front-end for B2B SaaS products — dense, data-heavy interfaces where
					clarity matters. I care as much about how an interface feels as how it’s built, which is
					where <a href={project('CoreKit')} target="_blank" rel="noopener noreferrer">CoreKit</a>, my component library, comes from.
				</p>
				<p>
					Most of my work revolves around TypeScript, React and modern web technologies, but I’m
					always learning. Recently I’ve been spending more time exploring system design,
					networking, cloud infrastructure and the foundations that sit beneath the frameworks we
					use every day. <a href={project('Tally')} target="_blank" rel="noopener noreferrer">Tally</a>, a ledger API on raw Node and
					Postgres, is where I break those ideas on purpose to understand them.
				</p>
				<p>
					Outside of software you’ll usually find me at the gym, reading comics, watching anime,
					cooking or working on side projects. I’m also becoming increasingly interested in
					electronics and embedded systems.
				</p>
				<p>
					If you’re working on something interesting, I’d love to hear about
					it — <a href={`mailto:${PROFILE.email}`}>get in touch</a>.
				</p>
				<h2 class="now-heading">Now</h2>
				<NowList />
			</div>
		</div>
	</main>
</Base>

<style>
	.page {
		padding-top: calc(64px + clamp(3rem, 8vw, 6rem));
		padding-bottom: clamp(4rem, 10vw, 8rem);
	}
	.page-head {
		margin-bottom: clamp(3rem, 7vw, 5rem);
	}
	h1 {
		margin-top: 1rem;
		font-size: clamp(2.5rem, 7vw, 5rem);
		letter-spacing: -0.05em;
		max-width: 16ch;
	}
	h1 .serif {
		color: var(--muted);
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: clamp(2rem, 6vw, 5rem);
		border-top: 1px solid var(--line);
		padding-top: 2.5rem;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		text-transform: none;
	}
	.meta div {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.meta .muted {
		text-transform: uppercase;
	}
	.meta a:hover {
		color: var(--accent);
	}
	.prose {
		font-size: 1.15rem;
		max-width: 60ch;
	}
	.now-heading {
		margin-bottom: 1.5rem;
	}
	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>

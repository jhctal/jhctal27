---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Base from '../../layouts/Base.astro';
import { SHOW_WRITING, SITE_TITLE } from '../../consts';

if (!SHOW_WRITING) return Astro.redirect('/');

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title={`Writing — ${SITE_TITLE}`}>
	<main class="container page">
		<header class="page-head">
			<span class="mono muted">Writing</span>
			<h1>Notes on <span class="serif">craft</span>, tools &amp; process.</h1>
		</header>
		<ul class="posts">
			{
				posts.map((post, i) => (
					<li data-reveal style={`--delay:${i * 50}ms`}>
						<a href={`/blog/${post.id}/`} class="post-row">
							<span class="mono muted date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<span class="body">
								<span class="title">{post.data.title}</span>
								<span class="desc muted">{post.data.description}</span>
							</span>
							<span class="arrow" aria-hidden="true">
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Base>

<style>
	.page {
		padding-top: calc(64px + clamp(3rem, 8vw, 6rem));
		padding-bottom: clamp(4rem, 10vw, 8rem);
	}
	.page-head {
		margin-bottom: clamp(3rem, 7vw, 5rem);
	}
	h1 {
		margin-top: 1rem;
		font-size: clamp(2.5rem, 7vw, 5rem);
		letter-spacing: -0.05em;
		max-width: 14ch;
	}
	.posts {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}
	.posts li {
		border-bottom: 1px solid var(--line);
	}
	.post-row {
		display: grid;
		grid-template-columns: 9rem 1fr auto;
		align-items: baseline;
		gap: 1.5rem;
		padding: 1.75rem 0;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.title {
		font-size: 1.35rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		transition: color 0.2s;
	}
	.desc {
		font-size: 0.95rem;
	}
	.arrow {
		color: var(--faint);
		transition:
			transform 0.5s var(--ease),
			color 0.2s;
	}
	.post-row:hover .arrow {
		color: var(--accent);
		transform: translateX(4px);
	}
	@media (max-width: 640px) {
		.post-row {
			grid-template-columns: 1fr auto;
			gap: 0.5rem 1rem;
		}
		.date {
			grid-column: 1 / -1;
		}
	}
</style>

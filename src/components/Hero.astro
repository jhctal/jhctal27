---
import { PROFILE } from '../consts';

const chars = [...PROFILE.name];
---

<section class="hero" aria-label="Introduction">
	<canvas class="hero-canvas" aria-hidden="true"></canvas>

	<div class="container hero-inner">
		<div class="hero-main">
			<h1 class="name" aria-label={PROFILE.name}>
				{
					chars.map((c, i) => (
						<span class="char-mask" aria-hidden="true">
							<span class="char" style={`--i:${i}`}>
								{c}
							</span>
						</span>
					))
				}
			</h1>
			<p class="tagline">
				<span class="role">{PROFILE.role}</span>
				<span class="serif">{PROFILE.tagline}</span>
			</p>
		</div>

		<div class="hero-bottom mono">
			<span class="status">
				<span class="status-dot" aria-hidden="true"></span>
				{PROFILE.status}
			</span>
			<span class="where">
				{PROFILE.location}
				<span class="sep" aria-hidden="true">/</span>
				<time class="clock" data-tz={PROFILE.timeZone}>--:--:--</time>
			</span>
			<a href="#work" class="scroll">
				Scroll
				<span class="scroll-line" aria-hidden="true"></span>
			</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		overflow: hidden;
		isolation: isolate;
	}
	.hero-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, #000 40%, transparent 100%);
		-webkit-mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, #000 40%, transparent 100%);
	}
	.hero-inner {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding-top: calc(64px + 1.5rem);
		padding-bottom: 1.75rem;
		pointer-events: none;
	}
	.hero-inner a {
		pointer-events: auto;
	}
	.hero-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		opacity: 0;
		animation: fade 1.2s var(--ease) 0.9s forwards;
	}

	.hero-main {
		/* Centre vertically in the space above the bottom bar */
		margin: auto 0;
		padding: 6vh 0;
	}
	.name {
		display: flex;
		font-size: clamp(6rem, 24vw, 22rem);
		font-weight: 300;
		line-height: 0.82;
		letter-spacing: -0.065em;
		margin-left: -0.06em;
		user-select: none;
	}
	.char-mask {
		display: inline-block;
		overflow: hidden;
		padding: 0 0.02em 0.06em;
		margin-bottom: -0.06em;
	}
	.char {
		display: inline-block;
		transform: translateY(105%);
		animation: rise 1.1s var(--ease) forwards;
		animation-delay: calc(var(--i) * 70ms + 100ms);
		will-change: font-weight;
	}

	.tagline {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 0.4em;
		margin-top: clamp(1.25rem, 3vw, 2rem);
		max-width: 34ch;
		font-size: clamp(1.4rem, 3.2vw, 2.4rem);
		line-height: 1.2;
		letter-spacing: -0.02em;
		opacity: 0;
		animation: fade-up 1.2s var(--ease) 0.55s forwards;
	}
	.tagline .role {
		font-weight: 500;
	}
	.tagline .serif {
		color: var(--muted);
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}
	.status-dot {
		position: relative;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #22c55e;
	}
	.status-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: inherit;
		animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
	}
	.where {
		color: var(--muted);
	}
	.sep {
		margin: 0 0.4em;
		color: var(--faint);
	}
	.clock {
		font-variant-numeric: tabular-nums;
	}
	.scroll {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--muted);
		transition: color 0.2s;
	}
	.scroll:hover {
		color: var(--fg);
	}
	.scroll-line {
		position: relative;
		width: 40px;
		height: 1px;
		background: var(--line);
		overflow: hidden;
	}
	.scroll-line::after {
		content: '';
		position: absolute;
		inset: 0;
		background: currentColor;
		transform: translateX(-100%);
		animation: slide 2.4s var(--ease) infinite;
	}

	@keyframes rise {
		to {
			transform: none;
		}
	}
	@keyframes fade {
		to {
			opacity: 1;
		}
	}
	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes ping {
		75%,
		100% {
			transform: scale(2.6);
			opacity: 0;
		}
	}
	@keyframes slide {
		60%,
		100% {
			transform: translateX(100%);
		}
	}

	@media (max-width: 640px) {
		.hero-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
		.scroll {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.char,
		.tagline,
		.hero-bottom {
			animation: none;
			transform: none;
			opacity: 1;
		}
		.status-dot::after,
		.scroll-line::after {
			animation: none;
		}
	}
</style>

<script>
	const hero = document.querySelector<HTMLElement>('.hero')!;
	const canvas = hero.querySelector<HTMLCanvasElement>('.hero-canvas')!;
	const ctx = canvas.getContext('2d')!;
	const chars = [...hero.querySelectorAll<HTMLElement>('.char')];
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// ---- Live clock ----
	const clock = hero.querySelector<HTMLTimeElement>('.clock')!;
	const fmt = new Intl.DateTimeFormat('en-GB', {
		timeZone: clock.dataset.tz,
		hour: '2-digit',
		minute: '2-digit',
		second: '2-digit',
		hour12: false,
	});
	const tick = () => (clock.textContent = fmt.format(new Date()));
	tick();
	setInterval(tick, 1000);

	// ---- Dot field ----
	const GAP = 24;
	const RADIUS = 180;
	type Dot = { x: number; y: number };
	type Ripple = { x: number; y: number; t: number };

	let width = 0;
	let height = 0;
	let dots: Dot[] = [];
	let ripples: Ripple[] = [];
	let dotRgb = '11, 11, 12';
	let accent = '#ff4f12';

	const pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, last: 0 };
	let charCenters: number[] = [];

	function readColors() {
		const cs = getComputedStyle(document.documentElement);
		dotRgb = cs.getPropertyValue('--dot').trim();
		accent = cs.getPropertyValue('--accent').trim();
	}

	function resize() {
		const dpr = Math.min(devicePixelRatio || 1, 2);
		width = hero.clientWidth;
		height = hero.clientHeight;
		canvas.width = width * dpr;
		canvas.height = height * dpr;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

		dots = [];
		const ox = (width % GAP) / 2;
		const oy = (height % GAP) / 2;
		for (let y = oy; y <= height; y += GAP) {
			for (let x = ox; x <= width; x += GAP) dots.push({ x, y });
		}

		const heroRect = hero.getBoundingClientRect();
		charCenters = chars.map((c) => {
			const r = c.getBoundingClientRect();
			return r.left - heroRect.left + r.width / 2;
		});
	}

	const smooth = (v: number) => v * v * (3 - 2 * v);

	function draw(t: number) {
		ctx.clearRect(0, 0, width, height);

		// Idle: let the focus point wander so the field never feels dead
		if (t - pointer.last > 2500) {
			pointer.tx = width * (0.5 + 0.32 * Math.sin(t * 0.00031));
			pointer.ty = height * (0.5 + 0.28 * Math.sin(t * 0.00047 + 1.3));
		}
		if (pointer.x < -1000) {
			pointer.x = pointer.tx;
			pointer.y = pointer.ty;
		}
		pointer.x += (pointer.tx - pointer.x) * 0.09;
		pointer.y += (pointer.ty - pointer.y) * 0.09;

		ripples = ripples.filter((r) => t - r.t < 1600);

		for (const d of dots) {
			const dx = d.x - pointer.x;
			const dy = d.y - pointer.y;
			const dist = Math.hypot(dx, dy) || 1;
			const inf = dist < RADIUS ? smooth(1 - dist / RADIUS) : 0;

			let ring = 0;
			let rx = 0;
			let ry = 0;
			for (const r of ripples) {
				const age = t - r.t;
				const rdx = d.x - r.x;
				const rdy = d.y - r.y;
				const rd = Math.hypot(rdx, rdy) || 1;
				const band = Math.abs(rd - age * 0.7);
				if (band < 48) {
					const k = (1 - band / 48) * (1 - age / 1600);
					ring += k;
					rx += (rdx / rd) * k;
					ry += (rdy / rd) * k;
				}
			}

			const wave = Math.sin(d.x * 0.011 + t * 0.0007) * Math.cos(d.y * 0.013 - t * 0.0005);
			const push = inf * 22;
			const x = d.x + (dx / dist) * push + rx * 10;
			const y = d.y + (dy / dist) * push + ry * 10 + wave * 1.5;
			const size = 0.9 + inf * 1.7 + ring * 1.4;
			const alpha = Math.min(1, 0.16 + wave * 0.07 + inf * 0.45 + ring * 0.5);

			ctx.globalAlpha = alpha;
			ctx.fillStyle = `rgb(${dotRgb})`;
			ctx.beginPath();
			ctx.arc(x, y, size, 0, Math.PI * 2);
			ctx.fill();

			const glow = Math.min(1, inf * 0.9 + ring);
			if (glow > 0.02) {
				ctx.globalAlpha = glow;
				ctx.fillStyle = accent;
				ctx.fill();
			}
		}
		ctx.globalAlpha = 1;

		// Name letters thicken as the pointer approaches
		const heroTop = hero.getBoundingClientRect().top;
		const nameY = chars[0]?.getBoundingClientRect().top - heroTop + chars[0]?.offsetHeight / 2;
		chars.forEach((c, i) => {
			const d = Math.hypot(pointer.x - charCenters[i], (pointer.y - nameY) * 0.6);
			const k = d < 420 ? smooth(1 - d / 420) : 0;
			c.style.fontWeight = String(Math.round(300 + k * 500));
		});
	}

	let raf = 0;
	let running = false;
	const loop = (t: number) => {
		draw(t);
		raf = requestAnimationFrame(loop);
	};
	function start() {
		if (running || reduceMotion) return;
		running = true;
		raf = requestAnimationFrame(loop);
	}
	function stop() {
		running = false;
		cancelAnimationFrame(raf);
	}

	hero.addEventListener('pointermove', (e) => {
		const r = hero.getBoundingClientRect();
		pointer.tx = e.clientX - r.left;
		pointer.ty = e.clientY - r.top;
		pointer.last = performance.now();
	});
	hero.addEventListener('pointerleave', () => (pointer.last = 0));
	hero.addEventListener('pointerdown', (e) => {
		const r = hero.getBoundingClientRect();
		ripples.push({ x: e.clientX - r.left, y: e.clientY - r.top, t: performance.now() });
	});

	new ResizeObserver(() => {
		resize();
		if (reduceMotion) draw(0);
	}).observe(hero);

	new MutationObserver(() => {
		readColors();
		if (reduceMotion) draw(0);
	}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

	new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(hero);
	document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

	// Letter positions shift once the webfont loads
	document.fonts.ready.then(resize);

	readColors();
	resize();
	if (reduceMotion) draw(0);
</script>

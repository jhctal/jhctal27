---
import { PROFILE, SOCIALS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<span class="mono">&copy; {year} {PROFILE.fullName}</span>
		<ul>
			{
				SOCIALS.map((s) => (
					<li>
						<a href={s.href} target="_blank" rel="noopener noreferrer" class="mono">
							{s.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		color: var(--muted);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 2rem;
		padding-bottom: 2rem;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		transition: color 0.2s;
	}
	a:hover {
		color: var(--fg);
	}
</style>
